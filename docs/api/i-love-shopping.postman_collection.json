		{
			"name": "Cart",
			"description": "Shopping cart operations",
			"item": [
				{
					"name": "Get Cart",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/cart",
							"host": ["{{baseUrl}}"],
							"path": ["cart"]
						}
					}
				},
				{
					"name": "Create Cart (Anonymous)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Cookie",
								"value": "cartSessionId={{cartSessionId}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/cart",
							"host": ["{{baseUrl}}"],
							"path": ["cart"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.sessionId) {",
									"    pm.collectionVariables.set('cartSessionId', jsonData.data.sessionId);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Add Item to Cart",
