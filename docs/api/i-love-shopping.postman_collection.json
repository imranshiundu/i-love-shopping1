{
	"info": {
		"name": "I Love Shopping - B2C E-commerce Platform",
		"description": "Complete API collection for the I Love Shopping B2C e-commerce platform with M-Pesa integration.\n\n**Base URL:** http://localhost:8080\n\n**Authentication:**\n- Register/Login to get access token and refresh token\n- Set `accessToken` variable in the collection\n- Refresh token is stored in cookie automatically\n\n**Environment Variables:**\n- `baseUrl`: http://localhost:8080\n- `accessToken`: (auto-set after login)\n- `refreshToken`: (auto-set after login)\n- `cartSessionId`: (auto-set after cart creation)\n\n**Admin Role Required:**\n- Category/Brand/Product CRUD operations require ADMIN role",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "accessToken",
			"value": ""
		},
		{
			"key": "refreshToken",
			"value": ""
		},
		{
			"key": "cartSessionId",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Authentication",
			"description": "User registration, login, and authentication endpoints",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123!\",\n  \"phone\": \"+254712345678\",\n  \"recaptchaToken\": \"test-token\"\n}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.accessToken) {",
									"    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
									"    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Login User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password123!\",\n  \"recaptchaToken\": \"test-token\"\n}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.accessToken) {",
									"    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
									"    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Cookie",
								"value": "refreshToken={{refreshToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "refresh"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.accessToken) {",
									"    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
									"    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Logout User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Cookie",
								"value": "refreshToken={{refreshToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "logout"]
						}
					}
				},
				{
					"name": "Logout All Sessions",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/logout-all",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "logout-all"]
						}
					}
				},
				{
					"name": "Forgot Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/forgot-password",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "forgot-password"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"john@example.com\"\n}"
						}
					}
				},
				{
					"name": "Reset Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/reset-password",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "reset-password"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"reset-token-here\",\n  \"newPassword\": \"NewPassword123!\"\n}"
						}
					}
				},
				{
					"name": "Verify Email",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/auth/verify-email?token=verification-token",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "verify-email"],
							"query": [
								{
									"key": "token",
									"value": "verification-token"
								}
							]
						}
					}
				},
				{
					"name": "Get CAPTCHA Site Key",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/auth/verify-captcha",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "verify-captcha"]
						}
					}
				},
				{
					"name": "Setup 2FA",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/2fa/setup",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "2fa", "setup"]
						}
					}
				},
				{
					"name": "Enable 2FA",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/2fa/enable",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "2fa", "enable"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"code\": \"123456\"\n}"
						}
					}
				},
				{
					"name": "Disable 2FA",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/2fa/disable",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "2fa", "disable"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"password\": \"Password123!\"\n}"
						}
					}
				},
				{
					"name": "Verify 2FA Code",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/2fa/verify",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "2fa", "verify"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"john@example.com\",\n  \"code\": \"123456\",\n  \"password\": \"Password123!\"\n}"
						}
					}
				}
			]
		},
