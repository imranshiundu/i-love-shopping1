						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/cart/items/{{itemId}}",
							"host": ["{{baseUrl}}"],
							"path": ["cart", "items", "{{itemId}}"]
						}
					}
				},
				{
					"name": "Clear Cart",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/cart",
							"host": ["{{baseUrl}}"],
							"path": ["cart"]
						}
					}
				}
			]
		},
