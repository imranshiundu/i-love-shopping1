# =============================================================================
# i-Love-Shopping Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Only database + Redis + RabbitMQ are required to start.
# Payment providers are optional — configure one or more as needed.
# =============================================================================

# ---- Required: Database ----
DATABASE_URL=jdbc:postgresql://localhost:5433/iloveshopping?stringtype=unspecified
DATABASE_USER=iloveshopping
DATABASE_PASSWORD=iloveshopping

# ---- Required: Redis ----
REDIS_HOST=localhost
REDIS_PORT=6380

# ---- Required: RabbitMQ ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=iloveshopping
RABBITMQ_PASSWORD=iloveshopping

# ---- Mail (dev only — uses MailHog) ----
MAIL_HOST=localhost
MAIL_PORT=1025

# ---- Server ----
SERVER_PORT=8080

# ---- reCAPTCHA (dev only) ----
RECAPTCHA_SECRET_KEY=dev-test-secret
RECAPTCHA_SITE_KEY=dev-recaptcha-site-key

# =============================================================================
# PAYMENT PROVIDERS — configure at least one
# =============================================================================

# ---- M-Pesa Daraja (for Kenya testers) ----
# Get keys from: https://developer.safaricom.co.ke
# Sandbox credentials:
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:8080/api/v1/orders/payments/mpesa/callback
MPESA_TIMEOUT_URL=http://localhost:8080/api/v1/orders/payments/mpesa/timeout
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# ---- Stripe (for Estonia / worldwide card testers) ----
# Get keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Flutterwave (for Africa-wide card testers) ----
# Get keys from: https://app.flutterwave.com → Settings → API Keys
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_REDIRECT_URL=http://localhost:3000/checkout/success
