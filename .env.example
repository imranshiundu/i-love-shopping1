# =============================================================================
# i-Love-Shopping Environment Configuration
# =============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Only database + Redis + RabbitMQ are required to start.
# Payment providers are optional — configure one or more as needed.
#
# QUICK START:
#   1. ./scripts/dev.sh --auto    (starts everything)
#   2. Visit http://localhost:3000
# =============================================================================

# ---- Required: Database ----
DATABASE_URL=jdbc:postgresql://localhost:5433/iloveshopping?stringtype=unspecified
DATABASE_USER=iloveshopping
DATABASE_PASSWORD=iloveshopping

# ---- Required: Redis ----
REDIS_HOST=localhost
REDIS_PORT=6380

# ---- Required: RabbitMQ ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=iloveshopping
RABBITMQ_PASSWORD=iloveshopping

# ---- Server ----
SERVER_PORT=8080
APP_NAME=i-love-shopping
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- reCAPTCHA (dev only — bypasses verification) ----
RECAPTCHA_SECRET_KEY=dev-test-secret
RECAPTCHA_SITE_KEY=dev-recaptcha-site-key

# ---- JWT (change in production!) ----
JWT_SECRET=i-love-shopping-jwt-secret-key-2024-production-change-me
JWT_ACCESS_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

# ---- Commerce settings ----
FREE_SHIPPING_THRESHOLD=5000
SHIPPING_COST=10
TAX_RATE=0.16
DEFAULT_CURRENCY=KES
DEFAULT_COUNTRY=KE

# =============================================================================
# EMAIL — choose one option
# =============================================================================

# OPTION A: MailHog (local dev — emails are captured, not sent)
# View captured emails at: http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=noreply@iloveshopping.com
MAIL_FROM_NAME=i-love-shopping

# OPTION B: Brevo / Sendinblue (production — real emails)
# Sign up at: https://www.brevo.com
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=your-login@example.com
# MAIL_PASSWORD=your-smtp-key
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=noreply@yourdomain.com
# MAIL_FROM_NAME=Your Store

# OPTION C: Gmail (less reliable for production)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password  (not your regular password)
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true

# =============================================================================
# M-Pesa (Safaricom Daraja API) — Kenya payments
# =============================================================================
# Sandbox credentials are pre-filled for testing.
# Get your own at: https://developer.safaricom.co.ke
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=o6tPhH5EoSsGmtLZAG4yMT7b2GQp9e87X3h4T6dk0DuZh2aU
MPESA_CONSUMER_SECRET=LgJ5V6tShu5SCA9nhcyAA8qrkuq3nHUsbQdmCDRinBIPmjGEY2hVmxoqi28XSdPE
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_BASE_URL=https://sandbox.safaricom.co.ke

# Callback URL — must be publicly reachable by Safaricom.
# For local testing, use a tunnel:
#   - cloudflared: https://api.orb21.com (named tunnel)
#   - cloudflared quick: https://xxxx.trycloudflare.com
#   - ngrok: https://xxxx.ngrok.io
#   - serveo: https://xxxx.serveousercontent.com
MPESA_CALLBACK_URL=https://api.orb21.com/api/v1/orders/payments/mpesa/callback
MPESA_TIMEOUT_URL=https://api.orb21.com/api/v1/orders/payments/mpesa/timeout

# =============================================================================
# Stripe — card payments (worldwide)
# =============================================================================
# Get test keys at: https://dashboard.stripe.com/test/apikeys
# Test card: 4242 4242 4242 4242 · any future expiry · any CVC
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# Flutterwave — card payments (Africa)
# =============================================================================
# Get test keys at: https://dashboard.flutterwave.com
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_REDIRECT_URL=http://localhost:3000/checkout/success

# =============================================================================
# Rate limiting
# =============================================================================
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=100
