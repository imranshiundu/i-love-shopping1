#!/bin/bash
# Pre-commit hook - runs before each commit

set -e

echo "Running pre-commit checks..."

# Check for secrets in staged files
if git diff --cached --name-only | xargs grep -l -E "(password|secret|key|token).*=.*[\"'].{8,}" 2>/dev/null; then
    echo "ERROR: Potential secrets found in staged files!"
    echo "Please remove secrets before committing."
    exit 1
fi

# Validate commit message format (if commit message file exists)
if [ -f .git/COMMIT_EDITMSG ]; then
    COMMIT_MSG=$(cat .git/COMMIT_EDITMSG)
    if ! echo "$COMMIT_MSG" | grep -qE "^(feat|fix|docs|refactor|test|chore|build|ci|perf|security)\(.+\): .+"; then
        echo "WARNING: Commit message should follow conventional commits format:"
        echo "  <type>(<scope>): <description>"
        echo "  Example: feat(auth): add JWT refresh token rotation"
    fi
fi

echo "Pre-commit checks passed!"
exit 0